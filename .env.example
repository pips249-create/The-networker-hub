# Copy to local.env, fill real values, then: npm run sync-env && npm start
# See LOCAL-DEV.md and SUPABASE-SETUP.md. Do not commit local.env / .env.

# ─── Required — Supabase ───
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Required — Auth / site ───
SESSION_SECRET=generate-a-long-random-string-at-least-32-chars
SITE_URL=http://localhost:3000
# Production: https://www.thenetworkerhub.com

# Soft-launch preview gate (omit or set DISABLE_SITE_ACCESS_GATE=true to open the site)
SITE_ACCESS_PASSWORD=choose-a-preview-password
# DISABLE_SITE_ACCESS_GATE=true

# One-time admin bootstrap — remove from Vercel after first admin exists
# ADMIN_SETUP_SECRET=one-time-setup-secret
# ADMIN_EMAIL=you@example.com
# ADMIN_INITIAL_PASSWORD=choose-a-strong-password

# ─── Required in production — Cron ───
# Vercel sends Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=openssl-rand-base64-32

# ─── Email (Resend) ───
# Required for bookings, reminders, invites, Command Centre tests.
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=The Networker Hub <hello@mail.thenetworkerhub.com>
# SUPPORT_EMAIL=hello@thenetworkerhub.com
#
# Password-reset / auth mail is off until you set:
# AUTH_SEND_EMAILS=true
# Never set AUTH_SHOW_RESET_LINK or AUTH_DEV_RESET_LINK in Production
# (Preview only, opt-in): AUTH_SHOW_RESET_LINK=true

# ─── Stripe ───
# STRIPE_SECRET_KEY=sk_test_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx
# See CHECKOUT-SETUP.md for Connect + live checklist.
# Never set STRIPE_WEBHOOK_SKIP_VERIFY on Vercel.

# ─── Optional ───
# EMAIL_ALLOWLIST=you@example.com
# OPENAI_API_KEY=  # not required — Hubert uses built-in FAQ + listings

# ─── Legacy Airtable (do not use for new work) ───
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=
