# Copy this file to .env and fill in real values (see SUPABASE-SETUP.md).
# Do not commit .env — it is listed in .gitignore.

# ─── Supabase ───
# Dashboard: https://supabase.com/dashboard/project/uztgzbjrmjbonfniyqcu
# Keys: Settings → API Keys → anon (public) + service_role (secret)
SUPABASE_URL=https://uztgzbjrmjbonfniyqcu.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATA_PROVIDER=supabase

# ─── Airtable (legacy — keep until migration is complete) ───
AIRTABLE_API_KEY=patxxxxxxxx
AIRTABLE_BASE_ID=appxxxxxxxx
AIRTABLE_EVENTS_TABLE=Events
AIRTABLE_TICKETS_TABLE=Tickets
AIRTABLE_ORGANISERS_TABLE=Organisers
# AIRTABLE_EVENTS_VIEW=Grid view
AIRTABLE_USERS_TABLE=Users

# ─── Auth / site ───
SESSION_SECRET=generate-a-long-random-string-at-least-32-chars
ADMIN_SETUP_SECRET=one-time-setup-secret
ADMIN_EMAIL=pips249@gmail.com
ADMIN_INITIAL_PASSWORD=choose-a-strong-password
SITE_URL=https://the-networker-hub.vercel.app

# Optional: email password resets via Resend
# Auth emails off by default. Set AUTH_SEND_EMAILS=true only when you want reset/invite mail.
# AUTH_SEND_EMAILS=false

# Required for Command Centre test sends and booking confirmations (copy from Vercel → local.env for localhost).
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=The Networker Hub <onboarding@resend.dev>
# Used for password resets (AUTH_SEND_EMAILS), booking confirmations, and Command Centre test sends.
# AUTH_DEV_RESET_LINK=true

# ─── Stripe (checkout → registrations) ───
# Secret key (test: sk_test_…, live: sk_live_…) — Developers → API keys
# Required for checkout with booking fee (4.5% + 20p per ticket).
# STRIPE_SECRET_KEY=sk_test_xxxx
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks → your endpoint
# STRIPE_WEBHOOK_SECRET=whsec_xxxx
# Payment Links in Supabase are a fallback when STRIPE_SECRET_KEY is not set.
# See CHECKOUT-SETUP.md for the full production checklist.

# Optional: Command Center
# AIRTABLE_LOGS_TABLE=System Logs
# AIRTABLE_ALERTS_TABLE=System Alerts
