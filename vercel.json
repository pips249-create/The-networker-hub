{
  "version": 2,
  "outputDirectory": ".",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/events/index.html", "destination": "/events/", "permanent": true },
    { "source": "/opportunities/index.html", "destination": "/opportunities/", "permanent": true },
    { "source": "/advertising.html", "destination": "/advertising", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://checkout.stripe.com; script-src 'self' 'unsafe-inline' https://js.stripe.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co https://api.stripe.com https://api.resend.com https://vitals.vercel-insights.com https://unpkg.com https://api.openai.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com https://connect.stripe.com https://maps.google.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/agents.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/booking-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/favourite-sales",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/organiser-listing-alerts",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/event-featured",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/opportunity-reminders",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/engagement-emails",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/organiser-rankings",
      "schedule": "0 10 1 * *"
    }
  ],
  "functions": {
    "api/cron.js": { "maxDuration": 60 },
    "api/auth.js": { "maxDuration": 15 },
    "api/admin.js": { "maxDuration": 15 },
    "api/organiser.js": { "maxDuration": 15 },
    "api/organisers.js": { "maxDuration": 15 },
    "api/events.js": { "maxDuration": 15 },
    "api/seo.js": { "maxDuration": 15 },
    "api/opportunities.js": { "maxDuration": 15 },
    "api/stripe-webhook.js": { "maxDuration": 15 },
    "api/contact-chat.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/seo/sitemap" },
    { "source": "/api/seo/:path*", "destination": "/api/seo" },
    { "source": "/api/seo-meta", "destination": "/api/seo" },
    { "source": "/api/hubert-schema", "destination": "/api/seo/hubert-schema" },
    { "source": "/api/hub-listings", "destination": "/api/events" },
    { "source": "/api/auth/:path*", "destination": "/api/auth" },
    { "source": "/api/site-access", "destination": "/api/auth/site-access" },
    { "source": "/api/admin/:path*", "destination": "/api/admin" },
    { "source": "/api/cron/:path*", "destination": "/api/cron" },
    { "source": "/api/organiser/:path*", "destination": "/api/organiser" },
    {
      "source": "/events/booking-success",
      "destination": "/events/booking-success.html"
    },
    {
      "source": "/events/:slug",
      "destination": "/events/event.html?slug=:slug"
    },
    {
      "source": "/opportunities/:slug",
      "destination": "/opportunities/opportunity.html?slug=:slug"
    },
    {
      "source": "/advertising",
      "destination": "/advertising.html"
    },
    {
      "source": "/organisers/:slug",
      "destination": "/events/organiser.html?slug=:slug"
    },
    {
      "source": "/admin/emails",
      "destination": "/admin/emails.html"
    },
    {
      "source": "/admin/system",
      "destination": "/admin/system.html"
    },
    {
      "source": "/admin/users",
      "destination": "/admin/users.html"
    },
    {
      "source": "/admin/featured",
      "destination": "/admin/featured.html"
    },
    {
      "source": "/admin/campaigns",
      "destination": "/admin/campaigns.html"
    },
    {
      "source": "/admin/import",
      "destination": "/admin/import.html"
    }
  ]
}
