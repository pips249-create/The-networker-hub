{
  "name": "the-networker-hub",
  "private": true,
  "description": "The Networker UK — static site + Vercel serverless API",
  "scripts": {
    "prestart": "node scripts/sync-local-env.js",
    "sync-env": "node scripts/sync-local-env.js",
    "start": "npx vercel dev",
    "dev:api": "DISABLE_SITE_ACCESS_GATE=true npx vercel dev --listen 3001",
    "dev:fast": "node scripts/dev-fast.js",
    "dev:all": "node scripts/dev-fast.js --with-api",
    "sync-stripe": "node scripts/sync-stripe-pricing.js",
    "deploy": "npx vercel --prod",
    "check:api": "node scripts/smoke-test-api.js",
    "check:opportunities": "node scripts/smoke-test-opportunities.js",
    "check:opportunities:live": "node scripts/smoke-test-opportunities.js https://www.thenetworkeruk.com",
    "check:local": "node scripts/smoke-test-site.js http://localhost:3000",
    "check:live": "node scripts/smoke-test-site.js https://www.thenetworkeruk.com",
    "check:member-roster": "node scripts/smoke-test-member-roster.js",
    "check:member-roster:local": "node scripts/smoke-test-member-roster.js http://localhost:3000",
    "seed-admin": "node scripts/seed-admin.js",
    "seed-sample-event": "node scripts/seed-sample-event.js",
    "seed-browse-events": "node scripts/seed-browse-events.js",
    "delete-seed-events": "node scripts/delete-seed-events.js",
    "test-review-e2e": "node scripts/review-e2e-test.js",
    "test-guest-visit-e2e": "node scripts/guest-visit-e2e-test.js",
    "test-category-exclusivity-e2e": "node scripts/category-exclusivity-e2e-test.js",
    "check:connect-checkout": "node scripts/smoke-test-connect-checkout.js",
    "check:free-ticket": "node scripts/smoke-test-free-ticket.js",
    "check:organiser-journey": "node scripts/smoke-test-organiser-journey.js",
    "reset:email2-claim-retest": "node scripts/reset-email2-claim-retest.js",
    "test:refund-policy": "node scripts/test-refund-policy-compliance.js",
    "test:city-partner-checkout": "node scripts/test-city-partner-checkout.js",
    "test:county-partner-checkout": "node scripts/test-county-partner-checkout.js",
    "test:opportunity-live-email": "node scripts/test-opportunity-live-email-dedupe.js",
    "test:opportunity-spotlight-slots": "node scripts/test-opportunity-spotlight-slots.js",
    "check:business-ops": "node scripts/check-business-ops-readiness.js",
    "check:dpas": "node scripts/check-dpa-register.js",
    "check:ops": "node scripts/check-ops-reliability.js",
    "export:hmrc-sellers": "node scripts/export-hmrc-seller-report.js",
    "check:data-export": "node scripts/smoke-test-data-export.js",
    "audit:marketing-opt-in": "node scripts/audit-legacy-marketing-opt-in.js",
    "build:launch-segments": "node scripts/build-launch-list-segments.js",
    "build:claim-rematch": "node scripts/build-claim-rematch-resend.js",
    "send:claim-rematch": "node scripts/send-claim-rematch-resend.js",
    "backfill:claim-invite-activity": "node scripts/backfill-claim-invite-activity.js",
    "build:affiliate-claim": "node scripts/build-affiliate-claim-resend.js",
    "send:affiliate-claim": "node scripts/send-affiliate-claim-resend.js",
    "build:franchise-claim": "node scripts/build-franchise-claim-resend.js",
    "send:franchise-claim": "node scripts/send-franchise-claim-resend.js",
    "seed-ranking-demo": "node scripts/seed-ranking-demo-reviews.js",
    "import-attendees": "node scripts/import-attendees-csv.js",
    "build-admin-css": "tailwindcss -c tailwind.admin.config.js -i ./css/admin-tailwind.src.css -o ./css/admin-tailwind.css --minify",
    "build-seo": "node scripts/build-hub-seo-data.js && node scripts/build-faq-html.js && node scripts/build-page-seo-html.js && node scripts/build-static-share-images.js && node scripts/build-llms-txt.js && node scripts/build-international-seo.js",
    "build": "npm run build-admin-css && npm run build-seo",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@sentry/node": "^10.71.0",
    "@supabase/supabase-js": "^2.107.0",
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^16.6.1",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
